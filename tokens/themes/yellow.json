{
  "id": "yellow",
  "name": "Yellow / Black",
  "description": "Yellow + black, orange accent. Brand yellow is only a CTA fill; links and focus are black.",
  "fonts": {
    "text": "'Space Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "heading": "'Space Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "tones": {
    "primary": "#FFD60A",
    "secondary": "#111111",
    "accent": "#FF6B00",
    "info": "#0284C7",
    "success": "#16A34A",
    "warning": "#B45309",
    "error": "#DC2626",
    "neutral": "#6B6963"
  },
  "base": {
    "light": {
      "bg": "#F5F5F2", "surface": "#FFFFFF", "surface-hover": "#F0F0EB", "elevated": "#FFFFFF",
      "text-primary": "#0A0A0A", "text-secondary": "#2A2A28", "text-tertiary": "#55534D",
      "border-subtle": "#ECEBE5", "border-default": "#E2E0D8", "border-strong": "#8C8A82",
      "disabled-bg": "#EDEDE8", "disabled-text": "#9C9A93"
    },
    "dark": {
      "bg": "#0A0A0A", "surface": "#161616", "surface-hover": "#202020", "elevated": "#262626",
      "text-primary": "#F5F5F2", "text-secondary": "#FFD60A", "text-tertiary": "#A3A19A",
      "border-subtle": "#222220", "border-default": "#2A2A28", "border-strong": "#6B6963",
      "disabled-bg": "#1E1E1E", "disabled-text": "#55534D"
    }
  },
  "overrides": {
    "light": { "global": { "link": "#0A0A0A", "focus": "#0A0A0A" } }
  },
  "density": "default",
  "radius": "soft"
}
