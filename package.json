{
  "name": "zn-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent design system (HTML + CSS + tokens) built for AI agents, with a React viewer app.",
  "scripts": {
    "build": "node tools/build.js",
    "check": "node tools/build.js --check",
    "dev": "vite --config app/vite.config.js",
    "app:build": "npm run build && vite build --config app/vite.config.js",
    "app:preview": "vite preview --config app/vite.config.js",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lefthook": "^1.10.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
